# ──────────────────────────────────────────────────────────────────────────────
# Morphism — environment variables
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# `NEXT_PUBLIC_*` vars are bundled to the browser — no secrets in those.
# ──────────────────────────────────────────────────────────────────────────────

# ── App API base (optional) ───────────────────────────────────────────────────
# Base URL prefixed by lib/api/client.ts. Empty = same-origin.
NEXT_PUBLIC_API_URL=

# ── Flood data delivery (client) ──────────────────────────────────────────────
# "pmtiles" (default) → map streams vector tiles + reads precomputed stats;
# "geojson" → legacy flow: full FeatureCollection + client-derived hex LODs.
# Every PMTiles fetch failure also falls back to geojson per-request.
NEXT_PUBLIC_FLOOD_DATA_MODE=pmtiles

# Public CDN base for pre-generated flood assets on Cloudflare R2 (browser-safe
# URL, not a secret). Objects are raw-gzip `.json.gz` + `.pmtiles`.
# Empty = client falls back to the /api/flood proxy for everything.
# Example: https://pub-xxxxxxxxxxxxxxxx.r2.dev
NEXT_PUBLIC_FLOOD_ASSET_BASE_URL=

# Optional dedicated base for PMTiles-era artifacts (detail.pmtiles /
# stats.json.gz / year overviews). Lets local dev serve `public/flood-assets`
# (built with `bun run build:flood -- --public`) while legacy gz assets stay on
# R2. A leading-slash value is resolved against the current origin.
# Example (local dev): /flood-assets
# Unset = everything resolves against NEXT_PUBLIC_FLOOD_ASSET_BASE_URL.
NEXT_PUBLIC_FLOOD_PMTILES_BASE_URL=

# ── Vallaris / GISTDA flood upstream (SERVER-ONLY — used by /api/flood) ───────
# The API key and upstream URL never reach the browser; all client requests go
# through the same-origin /api/flood route handler.
VALLARIS_API_KEY=
# Optional overrides (defaults live in src/app/api/flood/route.ts):
VALLARIS_BASE_URL=
VALLARIS_FLOOD_COLLECTION=

# ── Cloudflare R2 upload (SERVER-ONLY — used by scripts/build-flood-assets.ts)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_NAME=

# ── Asset-generation script options ───────────────────────────────────────────
# Where scripts/build-flood-assets.ts reads /api/flood from (dev server must be
# running there). Default: http://localhost:3000
GENERATE_SOURCE_BASE=
